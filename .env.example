# Copy to .env before `make up`. Every value here is a local demo placeholder;
# nothing in this file is a real credential.
COMPOSE_PROJECT_NAME=cerbos-poc

# Admin Console (browser entry point)
ADMIN_CONSOLE_PORT=4200

# PostgreSQL (internal to the compose network, never published)
POSTGRES_USER=cerbos_poc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cerbos_poc

# Oracle, the second dialect. Only started by `docker compose --profile oracle`,
# so these are unused until the dual-dialect suite asks for them. FREEPDB1 is the
# pluggable database the Oracle Free image creates.
ORACLE_USER=cerbos_poc
ORACLE_PASSWORD=change-me
ORACLE_SYS_PASSWORD=change-me
ORACLE_SERVICE=FREEPDB1
