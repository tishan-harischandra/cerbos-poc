# Copy to .env before `make up`. Every value here is a local demo placeholder;
# nothing in this file is a real credential.
COMPOSE_PROJECT_NAME=cerbos-poc

# Admin Console (browser entry point). The console has no container of its
# own: this publishes admin-service, which serves the bundle and proxies the
# console's API calls (ADR-008). The address is unchanged.
ADMIN_CONSOLE_PORT=4200

# Business UI (browser entry point)
BUSINESS_UI_PORT=4201

# PostgreSQL (internal to the compose network, never published)
POSTGRES_USER=cerbos_poc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cerbos_poc

# Oracle, the second dialect. Only started by `docker compose --profile oracle`,
# so these are unused until the dual-dialect suite asks for them. FREEPDB1 is the
# pluggable database the Oracle Free image creates.
ORACLE_USER=cerbos_poc
ORACLE_PASSWORD=change-me
ORACLE_SYS_PASSWORD=change-me
ORACLE_SERVICE=FREEPDB1

# Keycloak. Published, because a browser has to reach it to log in. The hostname
# is what a token claims as its issuer, so it must be the address the browser
# uses; the ADS verifies against exactly this string.
KEYCLOAK_PORT=8081
KEYCLOAK_HOSTNAME=http://localhost:8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# §7.1 installation selection. Set IDP_TYPE=WSO2_IS to select the other adapter;
# nothing else changes and no image is rebuilt. Who the tenant is - realm,
# issuer, client, service account secret - comes from the tenant registry
# (issue #76, deploy/tenant-registry.yaml) rather than from here, and every
# realm the registry names is served by the same deployment (issue #77):
# there is no installation-wide tenant mapping mode left to set either, since
# every realm derives its own tenant from itself.
IDP_TYPE=KEYCLOAK
IDP_ROLE_SOURCE=CLIENT

# Which mechanism elects the singleton workloads - the policy release pipeline
# and the outbox publisher (ADR-009). Unlike every other setting here, the code
# has no default for this: an unset value refuses to start, because the only
# "safe" guess would be to coordinate with nothing, which silently elects every
# replica at once.
#
# PG_ADVISORY is the choice for compose: it runs PostgreSQL, and this is the one
# type that gives real mutual exclusion rather than a lease. Set DATABASE on the
# oracle profile, K8S_LEASE on Kubernetes, or REDIS with the redis profile
# below. No image is rebuilt to change it. See the README's table.
LEADER_ELECTION_TYPE=PG_ADVISORY

# REDIS only, and unused otherwise. Redis is optional the way Oracle is:
# `docker compose --profile redis up` starts it.
LEADER_ELECTION_REDIS_ADDR=redis:6379

# Load-test profile only (issue #24): a second Keycloak, backed by a real
# database instead of dev-mode's ephemeral store, so the full population
# (§15 load model) can be bulk-loaded. `docker compose --profile loadtest up`.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_LOADTEST_PORT=8083
KEYCLOAK_LOADTEST_HOSTNAME=http://localhost:8083
