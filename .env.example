# Copy to .env before `make up`. Every value here is a local demo placeholder;
# nothing in this file is a real credential.
COMPOSE_PROJECT_NAME=cerbos-poc

# Admin Console (browser entry point)
ADMIN_CONSOLE_PORT=4200

# PostgreSQL (internal to the compose network, never published)
POSTGRES_USER=cerbos_poc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cerbos_poc
